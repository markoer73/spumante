# Wine Parity Repository Ignore Rules
# Never commit upstream Wine checkouts, build artifacts, or VM disk images.

.wine-upstream/
builds/
build/
Build/
build-*/
*.qcow2
*.iso
*.fd
*.rom
*.bin

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb
*.dwo

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary & OS files
*.tmp
*.log
*.bak
*.swp
.DS_Store

# Python cache
__pycache__/
*.py[cod]

# vcpkg & test output
vcpkg_installed/
Testing/
.cache/
