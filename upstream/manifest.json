        "dlls/bcrypt/bcrypt.h",
        "dlls/bcrypt/bcrypt.spec",
        "dlls/bcrypt/bcrypt_main.c"
      ],
      "required_conformance_tests": [
        "test_symmetric_key"
      ]
    },
    "kernelbase": {
      "upstream_path": "dlls/kernelbase",
      "upstream_tests_path": "dlls/kernelbase/tests",
      "base_upstream_commit": "wine-10.0-base",
      "merge_strategy": "3-way-backport-preserving-macos-blocks",
      "macos_acceleration": "Darwin libSystem / CoreFoundation / Mach",
      "tracked_files": [
        "dlls/kernelbase/kernelbase.spec",
        "dlls/kernelbase/kernelbase_stubs.c"
      ],
      "required_conformance_tests": []
    },
    "mfplat": {
      "upstream_path": "dlls/mfplat",
      "upstream_tests_path": "dlls/mfplat/tests",
      "base_upstream_commit": "wine-10.0-base",
      "merge_strategy": "3-way-backport-preserving-macos-blocks",
      "macos_acceleration": "VideoToolbox / CoreMedia / AVFoundation",
      "tracked_files": [
        "dlls/mfplat/mfplat.spec",
        "dlls/mfplat/mfplat_stubs.c"
      ],
      "required_conformance_tests": []
    }
  }
}
